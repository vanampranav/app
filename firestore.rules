rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          // .get(field, default) avoids "Property is undefined" evaluation
          // errors when a user doc has no isAdmin/role field (most users).
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['admin', 'superAdmin']
        )
      );
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─── COLLECTIONS ────────────────────────────────────────────────────────

    // User profiles & Legacy subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /aiCoachSchedules/{scheduleId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Read widened to any signed-in user so the marketing analytics dashboard
    // can list all app users. Write stays owner-only (unchanged).
    match /profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Challenges - Discovery is public, configuration is Admin-only
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /packages/{packageId} {
        allow read: if (isSignedIn() && (resource == null || resource.data.isActive == true)) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      // Sanitized public leaderboard. Any signed-in user may READ it (it holds
      // only display name + derived scores, no private measurements/photos/
      // payment). Only an admin-context recompute writes it.
      match /leaderboard/{userId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }

      match /participants/{userId} {
        allow list: if isAdmin();
        allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isAdmin() || (
          isOwner(userId) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'paymentStatus', 'eligibleForPrizes', 'disqualified', 'disqualificationReason',
              'amountDue', 'amountCollected', 'verifiedByAdminId', 'baselineSubmitted',
              'paymentFailureReason', 'paymentFailedAt', 'paymentFailedByAdminId', 'paymentReviewedAt',
              'finalPlacement', 'awardLabel'
            ]) ||
            // Participant's FIRST payment submission: pending → pending_review
            (
              resource.data.paymentStatus == 'pending' &&
              request.resource.data.paymentStatus == 'pending_review' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'paymentStatus', 'paymentMethod', 'paymentReference', 'paymentProofUrl',
                'paymentProofSubmittedAt', 'paymentProofNotes', 'latestPaymentRecordId', 'updatedAt'
              ])
            ) ||
            // Recovery re-submission after a failed payment: failed → pending_review
            // (must allow latestPaymentRecordId — resubmitPaymentProof sets a NEW record id)
            (
              resource.data.paymentStatus == 'failed' &&
              request.resource.data.paymentStatus == 'pending_review' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'paymentStatus', 'paymentMethod', 'paymentReference', 'paymentProofUrl',
                'paymentProofSubmittedAt', 'paymentProofNotes', 'latestPaymentRecordId', 'updatedAt'
              ])
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // Collection-group read: a user can query their own participant records
    // across all challenges (home "My Challenge / Join Challenge" tile).
    match /{path=**}/participants/{participantId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Challenge Submissions
    match /challengeSubmissions/{submissionId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Payment Records
    match /paymentRecords/{paymentId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications
    // Created either by an admin (addressed TO a participant) or by the user
    // themselves as a side effect of their own action (e.g. join → self-addressed
    // "challenge joined"). Deletes stay admin-only.
    match /notifications/{notificationId} {
      // Admins may read any notification (needed to dedupe reminder sends);
      // everyone else reads only their own.
      allow read: if isSignedIn() && (isAdmin() || resource.data.recipientUserId == request.auth.uid);
      allow create: if isSignedIn() && ( isAdmin() || request.resource.data.recipientUserId == request.auth.uid );
      allow update: if isSignedIn() && resource.data.recipientUserId == request.auth.uid
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if isAdmin();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Early-access marketing leads (public sign-up form)
    match /earlyAccessLeads/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
