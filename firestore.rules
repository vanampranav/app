rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superAdmin']
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ─── COLLECTIONS ────────────────────────────────────────────────────────

    // User profiles & Legacy subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();

      match /aiCoachSchedules/{scheduleId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Collection Group Rule for Challenge Participants
    // Required for Home screen to find challenges joined by the current user
    match /{path=**}/participants/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // Challenges - Discovery is public, configuration is Admin-only
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /packages/{packageId} {
        allow read: if (isSignedIn() && (resource == null || resource.data.isActive == true)) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /participants/{userId} {
        allow list: if isAdmin();
        allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
        allow create: if isSignedIn() && isOwner(userId);
        allow update: if isAdmin() || (
          isOwner(userId) &&
          (
            // Allow participants to update their own non-sensitive fields
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'paymentStatus', 'eligibleForPrizes', 'disqualified', 'disqualificationReason',
              'amountDue', 'amountCollected', 'verifiedByAdminId', 'baselineSubmitted',
              'paymentFailureReason', 'paymentFailedAt', 'paymentFailedByAdminId', 'paymentReviewedAt'
            ]) ||
            // OR allow resubmitting proof if payment failed
            (
              resource.data.paymentStatus == 'failed' &&
              request.resource.data.paymentStatus == 'pending_review' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'paymentStatus', 'paymentReference', 'paymentProofUrl',
                'paymentProofSubmittedAt', 'paymentProofNotes', 'updatedAt'
              ])
            )
          )
        );
        allow delete: if isAdmin();
      }
    }

    // Challenge Submissions
    match /challengeSubmissions/{submissionId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Payment Records
    match /paymentRecords/{paymentId} {
      allow read: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUserId == request.auth.uid
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow create, delete: if isAdmin();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
