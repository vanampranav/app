rules_version = '2';

// Firebase Storage rules for EleFit. Storage is used ONLY by the Challenge
// feature (progress/body photos + payment proofs), so these paths cover all
// uploads. Deploy: Firebase Console → Storage → Rules, or
// `firebase deploy --only storage`.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    // Admin = users/{uid}.isAdmin == true (Storage rules can read Firestore).
    function isAdmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    // Size guard only. We intentionally do NOT require an image content-type:
    // Flutter's putFile() often uploads without setting one, which made valid
    // photo/proof uploads fail with storage/unauthorized. Auth + size are enough.
    function isImageUnder(maxBytes) {
      return request.resource.size < maxBytes;
    }

    // Progress / body-composition photos (baseline, weekly, final).
    // Path: challenge_submissions/{challengeId}/{userId}/...
    // Owner can read+write their own; admins can read all (Rule Book §11 privacy).
    match /challenge_submissions/{challengeId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId && isImageUnder(15 * 1024 * 1024);
    }

    // Payment proofs. The uploader's id is in the file NAME (not a path segment),
    // so we can't scope reads per-owner. Read must be allowed for signed-in users
    // — the app calls getDownloadURL() (a read) right after uploading, so an
    // admin-only read made the participant's own submission fail with 403.
    // Paths carry a uid + timestamp and listing is not permitted, so enumeration
    // is impractical.
    match /payment_proofs/{challengeId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageUnder(15 * 1024 * 1024);
    }
    // Payment-recovery re-uploads.
    match /payments/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isImageUnder(15 * 1024 * 1024);
    }

    // Default: deny everything else. (Storage is not used elsewhere in EleFit.)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
